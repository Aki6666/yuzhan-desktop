# pnpm 11 打包前置（PLAN.md §14.2）：hoisted 布局是 electron-builder 打包必需
node-linker=hoisted

# electron 二进制国内镜像（npmmirror），避免 GitHub 下载失败
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# 依赖源（本机环境为国内网络，固定 npmmirror）
registry=https://registry.npmmirror.com/

# pnpm store 指向仓库内缓存目录（沙箱/环境要求，不入库，见 .gitignore）；
# pnpm 11 实际以 pnpm-workspace.yaml 的 storeDir 为准（E:/言语积累Ak/.pnpm-store）
store-dir=E:/言语积累Ak/.pnpm-store

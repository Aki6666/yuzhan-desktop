{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "yuzhan://schemas/idiom.schema.json",
  "title": "语栈成语词条 Schema 母版（$defs 容器）",
  "description": "§5.7 双入口决策：idiom.full（严格）与 idiom.draft（宽松）由本文件同一份 $defs 组合导出，避免两处漂移。required 差异由 idiom.full.json / idiom.draft.json 两个入口文件控制。校验器 ajv v8（draft-07）。",
  "$defs": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "数据模型版本，字段演进走迁移（§5.5）"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]+(?:-[a-z]+)*-[0-9]{2}$",
      "description": "拼音slug + 两位序号，如 ju-gong-jin-cui-01（§5.5）；多音字按《普通话异读词审音表》人工确认"
    },
    "word": {
      "type": "string",
      "pattern": "^[\\u4e00-\\u9fa5]+$",
      "minLength": 2,
      "maxLength": 16,
      "description": "成语（汉字）"
    },
    "pinyin": {
      "type": "string",
      "pattern": "^[a-züāáǎàēéěèīíǐìōóǒòūúǔùǖǘǚǜ]+(?: [a-züāáǎàēéěèīíǐìōóǒòūúǔùǖǘǚǜ]+)*$",
      "description": "全拼（带声调），音节间空格分隔，如 jū gōng jìn cuì"
    },
    "meaning": {
      "type": "string",
      "minLength": 2,
      "description": "考试语境释义，多义项用「；」分隔（§5.1）"
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "description": "出处（可空）"
    },
    "usage": {
      "type": "string",
      "minLength": 1,
      "description": "适用对象/语境（可空）"
    },
    "emotion": {
      "enum": ["褒", "贬", "中性"],
      "description": "感情色彩（§5.3 受控枚举）"
    },
    "register": {
      "enum": ["谦辞", "敬辞", "无"],
      "description": "交际语域，与 emotion 正交拆维（§5.3 受控枚举）"
    },
    "errorType": {
      "enum": [
        "望文生义",
        "形近/音近混淆",
        "语义重复",
        "搭配不当",
        "对象误用",
        "谦敬错位",
        "褒贬误用",
        "轻重失当"
      ],
      "description": "8 类误用类型（§5.2 判定表）"
    },
    "nearItem": {
      "type": "object",
      "properties": {
        "word": { "type": "string", "minLength": 2 },
        "diff": { "type": "string", "minLength": 1, "description": "一句话说清核心区别（必填，§5.7#5）" }
      },
      "required": ["word", "diff"],
      "additionalProperties": false
    },
    "exampleItem": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "minLength": 3 },
        "exam": { "type": "string", "minLength": 1, "description": "卷别（引用 exams.json）；kind=exam 必带，kind=made 可空（§5.7#3）" },
        "kind": { "enum": ["exam", "made"], "description": "exam=真题（必带卷别）/ made=自造（§5.1）" }
      },
      "required": ["text", "kind"],
      "additionalProperties": false
    },
    "idiomProperties": {
      "type": "object",
      "description": "词条全部字段（§5.1），full/draft 共用同一属性定义",
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "id": { "$ref": "#/$defs/id" },
        "word": { "$ref": "#/$defs/word" },
        "pinyin": { "$ref": "#/$defs/pinyin" },
        "meaning": { "$ref": "#/$defs/meaning" },
        "origin": { "$ref": "#/$defs/origin" },
        "usage": { "$ref": "#/$defs/usage" },
        "emotion": { "$ref": "#/$defs/emotion" },
        "register": { "$ref": "#/$defs/register" },
        "near": {
          "type": "array",
          "items": { "$ref": "#/$defs/nearItem" },
          "maxItems": 5,
          "description": "近义辨析组，≤5（§5.7#5）"
        },
        "opposite": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "description": "反义（§5.7#6 引用存在性仅警告）"
        },
        "errorTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/errorType" },
          "minItems": 1,
          "maxItems": 2,
          "description": "可标 1–2 类（§5.2）；full 必填，draft 可缺"
        },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/exampleItem" },
          "maxItems": 3,
          "description": "≤3 条（§5.7#5）"
        },
        "frequency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "真题频次分档 1–5（§5.4）"
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1,
          "description": "本批真题选项中的出现次数（§6.3 批量导入统计口径；供列表同档排序，可空=教研备用词/未统计）"
        },
        "exams": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "引用 exams.json 词表（§5.3）"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 4,
          "description": "引用 tags.json 词表，≤4（§5.3/§5.7#5）"
        },
        "quality": {
          "enum": ["draft", "user", "reviewed"],
          "description": "draft=AI 初稿 / user=个人确认 / reviewed=人工过审（§5.1）"
        },
        "library": {
          "enum": ["official", "user"],
          "description": "official⟹reviewed 组合约束（§5.7#4）"
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "最近修订日期 YYYY-MM-DD；reviewed 必填（§5.7#7）"
        },
        "verifiedBy": {
          "type": "string",
          "minLength": 1,
          "description": "审核人；reviewed 必填（§5.7#7）"
        }
      },
      "additionalProperties": false
    }
  }
}
